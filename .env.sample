# TypeSafe API key for Jev. Create one at https://console.typesafe.ai, then:
#
#   cp .env.sample .env
#
# and paste the key in .env. jev_vision.py loads .env from the repository root,
# and the SDK reads TYPESAFE_API_KEY from the process environment. .env is
# gitignored, so the key stays out of the repo.
TYPESAFE_API_KEY=your-key-here
